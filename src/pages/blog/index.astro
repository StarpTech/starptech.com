---
import Layout from "../../layouts/Layout.astro";
import Masthead from "../../components/Masthead.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts[0];
const archive = posts.slice(1);

const fmt = (d: Date) =>
  d.toLocaleDateString("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

const readingMinutes = (body: string) =>
  Math.max(1, Math.round(body.split(/\s+/g).filter(Boolean).length / 220));
---

<Layout
  pageTitle="Writing — Dustin Deus"
  description="Writing by Dustin Deus on AI infrastructure, APIs, engineering teams, and building companies."
  ogType="website"
  schemaType="CollectionPage"
  headline="Writing"
  spotlight={false}
>
  <main class="page page--writing" id="content">
    <Masthead active="writing" />

    <article class="writing-index">
      <header class="writing-index__header">
        <p class="writing-index__eyebrow">
          Writing · {posts.length.toString().padStart(2, "0")} published {posts.length === 1 ? "note" : "notes"}
        </p>
        <h1 class="writing-index__title">
          Where systems meet reality.
        </h1>
        <p class="writing-index__intro">
          Architecture, inference, APIs, and the uncomfortable parts of shipping them.
        </p>
      </header>

      {
        posts.length === 0 ? (
          <p class="writing-index__empty">Nothing published yet.</p>
        ) : (
          <>
            <a class="featured-note" href={`/blog/${featured.slug}/`}>
              <div class="featured-note__meta">
                <span class="featured-note__latest">Latest</span>
                <span>{featured.data.category}</span>
                <span aria-hidden="true">·</span>
                <time datetime={featured.data.date.toISOString()}>
                  {fmt(featured.data.date)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{readingMinutes(featured.body)} min read</span>
              </div>
              <h2 class="featured-note__title">{featured.data.title}</h2>
              <p class="featured-note__description">{featured.data.description}</p>
              <span class="featured-note__read">
                Read note <span aria-hidden="true">↗</span>
              </span>
            </a>

            {archive.length > 0 && (
              <section class="writing-archive" aria-labelledby="archive-title">
                <h2 class="writing-archive__title" id="archive-title">More notes</h2>
                <ul class="writing-list" role="list">
                  {archive.map((post) => (
                    <li class="writing-list__item">
                      <a href={`/blog/${post.slug}/`} class="writing-list__link">
                        <time class="writing-list__date" datetime={post.data.date.toISOString()}>
                          {fmt(post.data.date)}
                        </time>
                        <div class="writing-list__copy">
                          <p class="writing-list__category">{post.data.category}</p>
                          <h3 class="writing-list__title">{post.data.title}</h3>
                          <p class="writing-list__description">{post.data.description}</p>
                        </div>
                        <span class="writing-list__arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </>
        )
      }
    </article>
  </main>
</Layout>
