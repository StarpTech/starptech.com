---
import Layout from "../../layouts/Layout.astro";
import Masthead from "../../components/Masthead.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en", {
    month: "short",
    day: "numeric",
  });

const readingMinutes = (body: string) =>
  Math.max(1, Math.round(body.split(/\s+/g).filter(Boolean).length / 220));

// newest year first; each year is one stretch of the thread
const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))].map((year) => ({
  year,
  posts: posts.filter((post) => post.data.date.getFullYear() === year),
}));
---

<Layout
  pageTitle="Writing — Dustin Deus"
  description="Writing by Dustin Deus on AI infrastructure, APIs, engineering teams, and building companies."
  ogType="website"
  schemaType="CollectionPage"
  headline="Writing"
  spotlight
>
  <main class="page page--writing" id="content">
    <Masthead active="writing" />

    <article class="writing-index">
      <header class="writing-index__header">
        <h1 class="writing-index__title">Where systems meet reality.</h1>
        <p class="writing-index__intro">
          Architecture, inference, APIs, and the uncomfortable parts of shipping them.
        </p>
      </header>

      {
        posts.length === 0 ? (
          <p class="writing-index__empty">Nothing published yet.</p>
        ) : (
          years.map(({ year, posts: notes }) => (
            <section class="writing-year" aria-labelledby={`year-${year}`}>
              <h2 class="writing-year__label" id={`year-${year}`}>{year}</h2>
              <ol class="writing-list" role="list">
                {notes.map((post) => (
                  <li>
                    <a href={`/blog/${post.slug}/`} class="writing-entry">
                      <span class="writing-entry__star" aria-hidden="true" />
                      <span class="writing-entry__meta">
                        <span>{post.data.category}</span>
                        <span aria-hidden="true">·</span>
                        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                        <span aria-hidden="true">·</span>
                        <span>{readingMinutes(post.body)} min</span>
                      </span>
                      <h3 class="writing-entry__title">{post.data.title}</h3>
                      <p class="writing-entry__description">{post.data.description}</p>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))
        )
      }
    </article>
  </main>
</Layout>
