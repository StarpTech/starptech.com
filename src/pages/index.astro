---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import ShoreArt from "../components/ShoreArt.astro";

const pageTitle = "Dustin Deus — Engineer and Founder";
const pageDescription =
    "Dustin Deus is an engineer and founder building companies, engineering teams, and software systems. Now at Leverage Computer.";
---

<Layout pageTitle={pageTitle} description={pageDescription} spotlight={false}>
    <ShoreArt />
    <main class="page page--home" id="content">
        <Masthead active="home" />

        <article class="home">
            <h1 class="home-hero">
                I build companies.
                <span class="home-hero__accent">
                    And the systems underneath.
                </span>
            </h1>

            <section class="home-story" aria-label="My story">
                <p class="home-story__lede">
                    I co-founded
                    <a
                        href="https://wundergraph.com"
                        target="_blank"
                        rel="noreferrer">WunderGraph</a>. Our first product
                    failed; four weeks later, we built Cosmo. We raised Seed and
                    Series A, and today it handles tens of billions of API
                    requests for teams including eBay, SoundCloud, and Paramount.
                </p>
                <p>
                    I built the engineering team and a low-ego culture of
                    openness, ownership, and high standards. That experience
                    changed how I think about leadership and still shapes how I
                    build. After that, I spent a short chapter running the
                    inference stack at
                    <a
                        href="https://opencode.ai/"
                        target="_blank"
                        rel="noreferrer">OpenCode</a>.
                </p>
            </section>

            <section class="home-story" aria-labelledby="now-title">
                <h2 class="home-kicker home-kicker--now" id="now-title">Now</h2>
                <p>
                    I’m the first Founding Engineer at
                    <a
                        href="https://leverage.computer/"
                        target="_blank"
                        rel="noreferrer">Leverage Computer</a>, building the
                    company computer: one AI-native system that connects a
                    company’s people, knowledge, and work.
                </p>
            </section>
        </article>
    </main>
</Layout>
