---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";

const pageTitle = "Dustin Deus — Engineer and Founder";
const pageDescription =
    "Dustin Deus is an engineer and founder building companies, engineering teams, and software systems. Now at Leverage Computer.";
---

<Layout pageTitle={pageTitle} description={pageDescription} signalField spotlight={false}>
    <main class="page page--home" id="content">
        <Masthead active="home" />

        <article class="home">
            <h1 class="home-hero">
                I build companies.
                <span class="home-hero__accent">
                    And the systems underneath.
                </span>
            </h1>

            <section class="home-story" aria-label="My story">
                <p>
                    I co-founded
                    <a
                        href="https://wundergraph.com"
                        target="_blank"
                        rel="noreferrer">WunderGraph</a>. Our first product
                    failed; four weeks later, we built Cosmo.
                    We raised Seed and Series A, and today it handles tens of
                    billions of API requests for teams including eBay, SoundCloud,
                    and Paramount.
                </p>

                <p>
                    I built the engineering team and a low-ego engineering
                    culture of openness, ownership, and high standards. That experience
                    changed how I think about leadership and still shapes how I
                    build.
                </p>
            </section>

            <section class="focus-card" aria-labelledby="focus-title">
                <div class="focus-card__eyebrow">
                    <span>Now · Leverage Computer</span>
                </div>
                <h2 class="focus-card__title" id="focus-title">
                    Building the company computer.
                </h2>
                <p>
                    After a short chapter running the inference stack at
                    <a
                        href="https://opencode.ai/"
                        target="_blank"
                        rel="noreferrer">OpenCode</a
                    >, I joined Leverage Computer as its first Founding Engineer.
                    I’m helping build the company, team, and an AI-native system
                    that connects a company’s people, knowledge, and work from the ground up.
                </p>
                <a
                    class="focus-card__link"
                    href="https://leverage.computer/"
                    target="_blank"
                    rel="noreferrer">Explore Leverage Computer <span aria-hidden="true">↗</span></a
                >
            </section>
        </article>
    </main>
</Layout>
