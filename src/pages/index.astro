---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";

const pageTitle = "Dustin Deus — Founder & Founding Engineer";
const pageDescription =
    "Dustin Deus — founder and engineer. Former co-founder & CTO at WunderGraph. Now Founding Engineer at Leverage Computer, building the company computer.";
---

<Layout pageTitle={pageTitle} description={pageDescription} signalField spotlight={false}>
    <main class="page page--home" id="content">
        <Masthead active="home" />

        <article class="home">
            <h1 class="home-hero">
                I build from <span class="home-hero__highlight">zero.</span>
                <span class="home-hero__accent">
                    Companies, teams, and the systems underneath.
                </span>
            </h1>

            <section class="home-story" aria-label="My story">
                <p>
                    I co-founded
                    <a
                        href="https://wundergraph.com"
                        target="_blank"
                        rel="noreferrer">WunderGraph</a
                    >
                    and helped turn it from an idea into a real company. The first
                    product failed. We built Cosmo in four weeks, raised Seed and
                    Series A, and today it helps teams at eBay, SoundCloud,
                    Paramount, and others handle tens of billions of API requests.
                </p>

                <p>
                    I hired every engineer and helped shape a culture around
                    ego-less collaboration, openness, ownership, and high
                    standards. Building something that supports dozens of people
                    and their families changes you. That experience still shapes
                    how I build.
                </p>
            </section>

            <section class="focus-card" aria-labelledby="focus-title">
                <div class="focus-card__eyebrow">
                    <span>Now · Leverage Computer</span>
                </div>
                <h2 class="focus-card__title" id="focus-title">
                    Building the company computer.
                </h2>
                <p>
                    After a short chapter running the inference stack at
                    <a
                        href="https://opencode.ai/"
                        target="_blank"
                        rel="noreferrer">OpenCode</a
                    >, I joined Leverage Computer as its first Founding Engineer.
                    I’m helping build the company, team, and an AI-native system
                    that connects a company’s people, knowledge, and work from the ground up.
                </p>
                <a
                    class="focus-card__link"
                    href="https://leverage.computer/"
                    target="_blank"
                    rel="noreferrer">Explore Leverage Computer <span aria-hidden="true">↗</span></a
                >
            </section>
        </article>
    </main>
</Layout>
