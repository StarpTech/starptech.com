---
const year = new Date().getFullYear();
const isHome = Astro.url.pathname === "/";
---

<footer class:list={["colophon", { "colophon--home": isHome }]}>
  {
    isHome && (
      <nav class="colophon__nav" aria-label="Elsewhere">
        <div class="colophon__socials">
          <a
            class="colophon__social"
            href="https://github.com/StarpTech"
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.17 1.18a10.98 10.98 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.76.11 3.05.74.8 1.19 1.82 1.19 3.08 0 4.42-2.7 5.38-5.28 5.67.42.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
            </svg>
          </a>
          <a
            class="colophon__social"
            href="https://www.linkedin.com/in/dustin-deus/"
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.04H3.54V8.98H7.1v11.47Z" />
            </svg>
          </a>
          <a
            class="colophon__social colophon__social--mail"
            href="mailto:deusdustin@gmail.com"
            aria-label="Email"
            title="Email"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 5.5h18v13H3z" />
              <path d="m3.5 6 8.5 7 8.5-7" />
            </svg>
          </a>
        </div>

        <div class="colophon__destinations">
          <a href="/blog">Writing</a>
          <a href="https://leverage.computer/careers/" target="_blank" rel="noreferrer">
            We're hiring <span aria-hidden="true">↗</span>
          </a>
        </div>
      </nav>
    )
  }

  <div class="colophon__base">
    <span>© {year} Dustin Deus</span>
    <a class="colophon__link" href="/llms.txt" title="Site index for LLMs (llms.txt standard)">
      llms.txt
    </a>
  </div>
</footer>
